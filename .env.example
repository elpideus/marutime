# ───────────────────────────── Core ─────────────────────────────
NODE_ENV=production
# Public URL of the app (no trailing slash). Used for links, emails and OAuth redirects.
APP_URL=https://marutime.elpideus.com

# PostgreSQL connection string. Neon / Supabase / local Docker all work.
# For Neon use the *pooled* connection string.
DATABASE_URL=postgres://user:password@host:5432/marutime?sslmode=require
# DATABASE_POOL_MAX=3

# Random secret (32+ chars). Generate with: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# Shared secret for cron endpoints (/api/cron/*). Vercel sends it automatically as a Bearer token.
CRON_SECRET=change-me-too

# ──────────────────────────── Metadata ────────────────────────────
# TMDB "API Read Access Token" (v4 auth), free at https://www.themoviedb.org/settings/api
TMDB_ACCESS_TOKEN=
# or the legacy v3 key
# TMDB_API_KEY=
# tmdb (default) or fixture (offline sample data for development)
METADATA_PROVIDER=tmdb

# ──────────────────────────── Storage ────────────────────────────
# local (Docker / self-hosted), s3 (Cloudflare R2, MinIO, Backblaze, AWS), vercel-blob
STORAGE_PROVIDER=s3
# local only
STORAGE_LOCAL_DIR=./data/uploads
# Public base URL for uploaded files (R2 custom domain or r2.dev URL). Leave empty for local.
STORAGE_PUBLIC_URL=https://cdn.marutime.elpideus.com
# S3-compatible settings (Cloudflare R2 example)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=marutime
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Vercel Blob only
# BLOB_READ_WRITE_TOKEN=

# Optional passphrase: encrypts backups (AES-256-GCM) before upload. Strongly recommended.
BACKUP_ENCRYPTION_KEY=

# ───────────────────────────── Email ─────────────────────────────
# console (log to stdout), resend, none
EMAIL_PROVIDER=none
EMAIL_FROM=MaruTime <no-reply@marutime.elpideus.com>
# RESEND_API_KEY=

# ───────────────────────────── OAuth (optional) ─────────────────────────────
# Redirect URI for each provider: {APP_URL}/auth/<provider>/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

# ───────────────────────────── Admin seed ─────────────────────────────
# Used by `pnpm db:seed` to create (or promote) the first admin account.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
# Leave empty to have a random password printed once.
ADMIN_PASSWORD=
